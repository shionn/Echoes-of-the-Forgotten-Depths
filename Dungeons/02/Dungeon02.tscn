[node name="description" type="Node" parent="RitualRoom/Decoration/Lorekeeper_Tome2" unique_id=1028790992]
script = ExtResource("13_iikjq")
text = "C'est un livre de prière à la déesse Veyrath. Mais un paragraphe me semble étrange :

[i]Dans le droit des os, les couleurs s’ordonnent.
Les profondeurs cachées, vers l’origine de leur propre direction.
Le passage se dévoile, et la mort guette.[/i]"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

