[node name="Aigle Jaune" parent="." unique_id=1882476485 instance=ExtResource("1_fq3ns")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 12, 0, -7.4)
