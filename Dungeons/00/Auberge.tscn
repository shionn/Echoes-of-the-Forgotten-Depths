[node name="Character" parent="Aigle Jaune" unique_id=1674546116 instance=ExtResource("6_od4xh")]

[node name="Bienvenue" type="Node" parent="Aigle Jaune" unique_id=1900171295 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Bonjour, aventurier. 

Bienvenue à l’« Auberge du Pigeon Perdu ». Vous semblez épuisé… Que vous est-il arrivé ?"
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/Bienvenue" unique_id=1011414265]
script = ExtResource("3_fq3ns")
text = "J’ai été attaqué par des voleurs. J’ai fui dans la forêt, je me suis perdu… J’ai erré pendant des jours. 

C’est la lumière de votre auberge qui m’a guidé jusqu’ici. Je n’ai plus un sou. Et je suis totalement épuisé."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/Bienvenue/Next" unique_id=1734174409 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Mon pauvre, cette histoire me semble familière. Vous n’êtes pas le premier ni le dernier à traverser de tel épreuves. Je vous propose un repas, et vous me rembourserez quand vous pourrez."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/Bienvenue/Next/Next" unique_id=512778115]
script = ExtResource("3_fq3ns")
text = "Mais comment pourrai-je gagner de l’argent ici ? Nous sommes au cœur de nulle part."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/Bienvenue/Next/Next/Next" unique_id=435261389 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Vous semblez bien équipé. Ne vous fiez pas à l’apparence : à première vue, cette auberge est isolée, mais le danger rôde autour de nous. Les missions ne rapportent pas beaucoup, mais je suis sûr que vous y trouverez des trésors."
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/Bienvenue/Next/Next/Next/Next" unique_id=902466358]
script = ExtResource("3_fq3ns")
text = "Merci, j’accepte avec joie votre proposition."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="ApportFood" type="Node" parent="Aigle Jaune/Bienvenue" unique_id=1368761772 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Votre repas est prêt. Il est sur le bar à gauche. J’ai préparé un ragoût de viande et de légumes, cuisiné avec des ingrédients locaux, accompagné d’un pain de campagne. Cela devrait vous redonner un peu d’énergie.

Vous semblez jeune. Si vous êtes à la recherche de travail, vous trouverez les annonces des missions sur le panneau près de l’entrée."
pnj = NodePath("../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="LookingForQuest" type="Node" parent="Aigle Jaune" unique_id=1344520848 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Vous semblez aller mieux. "
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Service de l\'auberge" type="Node" parent="Aigle Jaune/LookingForQuest" unique_id=655522223 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Que souhaites tu ? 
[ul]
Manger pour 10 PO ? [i]Cela restaure les points de vie[/i]
Dormir pour 10 PO ? [i]Cela reposera ton corp et d'accordera un bonus temporaire de défense[/i] (non disponible pour l'instant)
[/ul]"
pnj = NodePath("../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Manger" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge" unique_id=1322950200]
script = ExtResource("3_fq3ns")
text = "Je voudrais manger quelque chose."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge/Manger" unique_id=1824915166]
script = ExtResource("3_fq3ns")
text = "Je t'apporte quelque chose tous de suite. "
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge/Manger/Next" unique_id=557037624 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="ApportFood" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge/Manger/Next/Next" unique_id=182969767]
script = ExtResource("3_fq3ns")
text = "Votre repas est prêt. Il est sur le bar à gauche. J’ai préparé un ragoût de viande et de légumes, cuisiné avec des ingrédients locaux, accompagné d’un pain de campagne. Cela devrait vous redonner un peu d’énergie."
enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Travail" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge" unique_id=676093190]
script = ExtResource("3_fq3ns")
text = "J'ai besoin de trouver un travail."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Service de l\'auberge/Travail" unique_id=2099562861 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Si vous cherchez un travail, jetez un œil au panneau d’affichage près de l’entrée. Il y a des missions qui pourraient vous intéresser. 

Sinon, discutez avec les clients : ils proposent parfois des missions."
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Le Gouffre des Ombres" type="Node" parent="Aigle Jaune/LookingForQuest" unique_id=1410289639]
script = ExtResource("3_fq3ns")
text = "J’ai entendu dire que vous cherchez quelqu’un pour débarrasser [i]Le Gouffre des Ombres[/i] des morts-vivants ?"
enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Le Gouffre des Ombres" unique_id=1190841167 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Tu as des oreilles, hein ? Oui, on cherche quelqu’un. Mais pas n’importe qui. Tu crois que combattre des morts-vivants, c’est comme déterrer un lapin ? Deux aventuriers ont déjà essayé il y a trois jours. Ils ne sont toujours pas revenus. Probablement qu'ils ont rejoint les rangs des morts-vivants. Si tu veux tenter ta chance, il faut me prouver ta valeur. Une autre mission plus simple t’attend sur le panneau d’affichage à l’entrée."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Le Gouffre des Ombres/Next" unique_id=1540134795]
script = ExtResource("3_fq3ns")
text = "Je viens de prouver ma valeur dans le mausolé. Les morts-vivants ne font pas peur. Et puis, peut être que cela à un lien avec les morts-vivants qui sont apapru il y a peu de temps au mausolé."
enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Le Gouffre des Ombres/Next/Next" unique_id=2013660652 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Tu sais être convaincant. Très bien… le donjon se trouve au sud. Pour le rejoindre, prends la direction du sud. Tu tomberas sur un petit lac. L’entrée se trouve sur la rive est du lac. Tu dois te débarrasser de tous les morts-vivants, et essayer de trouver un indice sur celui qui est derrière tout ça. Si tu y arrives, je te donnerai une petite récompense."
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Mission Accomplie" type="Node" parent="Aigle Jaune/LookingForQuest" unique_id=48408100]
script = ExtResource("3_fq3ns")
text = "J'ai terrassé tous les mort-vivants de ce mausolée !"
enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie" unique_id=2000115723 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Tu semble en avoir bavé dans les profondeurs. 

Tu as accompli la mission ? Montre-moi une preuve."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next" unique_id=162401651]
script = ExtResource("3_fq3ns")
text = "Voilà : le crâne du golem squelette qui gardait l’étude. 

[i]Vous posez le crâne sur la table.[/i]

Mais… il n’y avait que des squelettes. Aucun nécromancien, aucun signe de magie."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next/Next" unique_id=1188886598 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Des squelettes ? Seuls ? C’est étrange. 

Les squelettes ne bougent pas sans un nécromancien. Normalement, ils ne peuvent rester animés que si le nécromancien est toujours dans les parages. 

Leur esprit est vide… à moins que quelque chose d'inconnu ne les ait animés. Tu es certain d’avoir bien fouillé le mausoléum ?"
pnj = NodePath("../../../../..")
close_enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="La potion étrange" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next/Next/Next" unique_id=328269447]
script = ExtResource("3_fq3ns")
text = "Oui… 

Mais j’ai trouvé quelque chose d’étrange. Une potion, Necrolis Attivae. Elle brille d’une lumière verte…"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next/Next/Next/La potion étrange" unique_id=150297420]
script = ExtResource("3_fq3ns")
text = "Neropolis Atire ? Je ne connais pas ce nom… C’est Pipette, l’alchimiste, qui doit savoir. Elle a des livres anciens. Tu devrais lui montrer cette potion.

Quoiqu'il en soit, il semble que tu ai accompli ta mission. Prends ceci. 10 pièces d’or. Moins les 2 pour ton repas."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Je n\'ai rien trouvé" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next/Next/Next" unique_id=1829865040]
script = ExtResource("3_fq3ns")
text = "Non absolument rien. "
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Mission Accomplie/Next/Next/Next/Je n\'ai rien trouvé" unique_id=938166655]
script = ExtResource("3_fq3ns")
text = "Si tu n’as rien trouvé… alors peut-être que la vérité est ailleurs. Parle à Alaric, l’historien. Il connaît l’histoire de cette région. 

Même sans indice, tu as risqué ta vie et accompli ta mission. Prends cela. 10 pièces d’or… moins les 2 pour ton repas."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Dungeon02 Accomplie" type="Node" parent="Aigle Jaune/LookingForQuest" unique_id=1201361476]
script = ExtResource("3_fq3ns")
text = "J’ai exploré et nettoyé le goufre des ombres, en voici la preuve. [i]Vous posez le crâne sur la table.[/i]"
label = "Mission Accomplie"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Dungeon02 Accomplie" unique_id=2052197835 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Bravo, voici ta récompense. 

As-tu trouvé des indices sur l’origine de ces événements ? D’où proviennent tous ces squelettes ? Il y a forcément quelqu’un derrière tout ça."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Dungeon02 Accomplie/Next" unique_id=896206820]
script = ExtResource("3_fq3ns")
text = "Oui, je pense que c’est Valthorion. Il est sorti de son sommeil."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Dungeon02 Accomplie/Next/Next" unique_id=283848416 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Impossible. Valthorion est mort il y a des lustres. Mes ancêtres s’en sont assurés."
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Dungeon02 Accomplie/Next/Next/Next" unique_id=1602258549]
script = ExtResource("3_fq3ns")
text = "Pourtant, je suis sûr que c’était lui. J’ai trouvé un autel à son nom. Il était écrit dessus : « Ici dors pour l’éternité, Valthorion. Son éveil accompagnera celui des morts. » 

Puis je l’ai surpris dans une étude. Il analysait cette bague. [i]Vous montrez la bague.[/i] Puis Valthorion a disparu dans un portail.  "
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Aigle Jaune/LookingForQuest/Dungeon02 Accomplie/Next/Next/Next/Next" unique_id=752238525]
script = ExtResource("3_fq3ns")
text = "Je ne comprends pas comment il peut être encore en vie… Cette bague me semble étrange. Montre-la à Ferris. Il en tirera peut-être quelque chose."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Luna Honey" parent="." unique_id=957068427 instance=ExtResource("1_fq3ns")]
transform = Transform3D(-0.5000001, 0, -0.8660254, 0, 1, 0, 0.8660254, 0, -0.5000001, 11.4, 0, 1.7)
script = ExtResource("2_52cfg")

[node name="Character" parent="Luna Honey" unique_id=917570229 instance=ExtResource("4_fq3ns")]
transform = Transform3D(0.99999994, 0, 0, 0, 1, 0, 0, 0, 0.99999994, 0, 0, 0)

[node name="Bienvenue" type="Node" parent="Luna Honey" unique_id=1214666615 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Bienvenue, aventurier ! Vous semblez épuisé… Restez, prenez le temps de vous ressourcer."
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Luna Honey/Bienvenue" unique_id=2123317625]
script = ExtResource("3_fq3ns")
text = "Bonjour, je vous avoue être épuisé. J’ai subi une attaque d’une bande de voleurs. J’ai réussi à les semer en fuyant dans la forêt.

Je n’ai plus rien, pas un sous. Tout ce que j’ai, c’est ce que je porte. J’ai erré des jours avant d’arriver ici. Où suis-je ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Luna Honey/Bienvenue/Next" unique_id=1285238277 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Effectivement, on voit bien que vous avez souffert. Vous êtes ici, à l’Auberge du Pigeon Perdu ! [i](elle sourit avec un mélange de compassion et d’amusement)[/i]
Vous savez, cette auberge a une réputation… un peu particulière. On dit qu’elle attire les voyageurs perdus, les aventuriers épuisés, et même les oiseaux qui ont perdu leur chemin. Mais ici, personne ne reste longtemps seul.
Le patron, lui, est un homme bienveillant. Il pourra sans doute vous aider. Vous le trouverez derrière le bar."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Bievenue_Restored" type="Node" parent="Luna Honey" unique_id=175022393 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Oh ! Vous semblez aller beaucoup mieux, maintenant !
Le chef a vraiment fait un travail remarquable… Il a préparé son fameux ragout de viande de bœuf et d’herbes sauvages. C’est une de ses spécialités, vous savez. On dit que cette recette donne des forces à quiconque la goûte…  

Puisque vous avez une dette envers le chef dorénavant, pourquoi ne pas accomplir l’une des missions qu’il propose sur le panneau d’affichage, à côté de l’entrée ?"
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Fréquentation" type="Node" parent="Luna Honey/Bievenue_Restored" unique_id=752681740]
script = ExtResource("3_fq3ns")
text = "Qui fréquente cet endroit ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Luna Honey/Bievenue_Restored/Fréquentation" unique_id=1866309077 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Le coin est tranquille, mais on a quelques réguliers. 
Alaric Duclair, par exemple. On dis qu’il est la depuis aussi longtemps que ces murs. Il écrit, relit, note tout ce qui se passe. Comme si le monde allait s’effondrer demain. 

Et puis, il y a Pipette la Loupe. On l’appelle ainsi à cause de ses lunettes. Elle prétend que ses potions sont [i]quasi-parfaites[/i], mais à chaque fois, quelque chose se gâte. Un jour, elle a fait exploser la cheminée. Depuis, on lui réserve une table à l’écart."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Luna Honey/Bievenue_Restored/Fréquentation/Next" unique_id=680676297 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Il y aussi Ferris Ardent, il n'a pas son pareil avec les pierres et metaux. Mais cette passion n'est rien en comparaison de celle qu'il entretient pour la bière. Il aime la solitude et reste tout le temps sur la mezzanine. Je lui fais juste signe quand il veut quelque chose.

Et vous ? Êtes vous de passage ? Ou allez vous vous installer ici ? "
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Mission Accomplie" type="Node" parent="Luna Honey/Bievenue_Restored" unique_id=591486330]
script = ExtResource("3_fq3ns")
text = "J'ai réussi ma mission !"
enable = false
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Luna Honey/Bievenue_Restored/Mission Accomplie" unique_id=2119219576 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Tu semble en avoir bavé dans les profondeurs, mais ce n'est pas à moi que tu dois en parler. Parles-en au patron pour recevoir ta récompense. "
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Alaric Duclair" parent="." unique_id=1224900324 instance=ExtResource("1_fq3ns")]
transform = Transform3D(0.76604456, 0, 0.64278764, 0, 1, 0, -0.64278764, 0, 0.76604456, 3.5999994, 0, -14.4)
script = ExtResource("8_doy55")

[node name="Character" parent="Alaric Duclair" unique_id=1328927383 instance=ExtResource("2_wji3q")]
transform = Transform3D(0.99999994, 0, 8.940697e-08, 0, 1, 0, -8.940697e-08, 0, 0.99999994, 0, 0, 0)

[node name="Présentation" type="Node" parent="Alaric Duclair" unique_id=623573044 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Vous êtes donc ici. Et pourtant, je vous connais déjà. Je ne sais pas comment, ni pourquoi. Mais les histoires de cette auberge sont plus anciennes que les hommes, et moi, Alaric Duclair, j’en suis le témoin, comme le temps l’a voulu.

Ces livres et ces parchemins. Ils racontent l’histoire de l’auberge, de ses maîtres, de ses ombres. Chaque récit, chaque légende, chaque mensonge, je les ai recueillis. Archivés. Ils sont ici, dans ce chaos, dans ces pages jaunies."
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation" unique_id=1744113509 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Si vous cherchez des vérités, ou des mensonges, je suis votre guide. Mais attention : ici, les histoires sont plus vieilles que les hommes. Et parfois, elles ont faim.

Alors, que cherchez-vous, étranger ? Une histoire ? Ou l’oubli ?"
pnj = NodePath("../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Nom de l\'Auberge ?" type="Node" parent="Alaric Duclair/Présentation/Next" unique_id=1196803019]
script = ExtResource("3_fq3ns")
text = "Pourquoi l’auberge s’appelle-t-elle « Au Pigeon Perdu » ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Nom de l\'Auberge ?" unique_id=1869022292 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "L’auberge a changé de nom de nombreuses fois au fil des années.

Chaque nouveau propriétaire a choisi un nom différent. Parfois, pour honorer un souvenir. Parfois, juste pour se distinguer. Aigle Jaune, le propriétaire actuel, a choisi « Au Pigeon Perdu » il y a une vingtaine d’années. Il disait que c’était un nom simple, qui évoquait un refuge pour ceux qui s’y perdaient. Quelqu’un qui s’arrête ici, qu’il soit perdu ou non, trouve un peu de paix, ici.
Aujourd’hui, c’est juste un nom. Comme les autres. Rien de plus."
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Nom de l\'Auberge ?/Next" unique_id=342711095]
script = ExtResource("3_fq3ns")
text = "Donc le pigeon, ce n’est pas l’Aigle Jaune ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Nom de l\'Auberge ?/Next/Next" unique_id=925172339 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Non. Le pigeon n’a rien à voir avec lui. L’Aigle Jaune a choisi ce nom pour une raison personnelle. Il disait que le pigeon représentait l’idée de « se perdre », de se retrouver, ou peut-être même de fuir. 

Ce n’était pas un animal, ni une personne. Juste une image."
pnj = NodePath("../../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Gouffre des Ombres ?" type="Node" parent="Alaric Duclair/Présentation/Next" unique_id=1561556844]
script = ExtResource("3_fq3ns")
text = "Que savez-vous sur le Gouffre des Ombres ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Gouffre des Ombres ?" unique_id=1296070086 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Autrefois, c’était une place forte creusée dans la montagne au sud, un bastion de pierre et de pierres précieuses. Juste à côté du [i]Lac d’Argent[/i], dont les eaux scintillent comme des diamants sous la lune. C’était un havre de paix et de culte pour la Déesse [i]Veyrath[/i], [i]Gardienne des Âmes Perdues et Reine des Ombres Éternelles[/i]. 
Mais il y a très longtemps, les habitants ont été touchés par une malédiction qui ravagea leurs corps et leurs esprits, et ils ont tous péri. Personne n’a jamais voulu s’y installer après cela. Depuis, les monstres errants — gobelins, orcs, et autres joyeusté — occupent ces lieux à tour de rôles.  "
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Valthorion ?" type="Node" parent="Alaric Duclair/Présentation/Next" unique_id=178631761]
script = ExtResource("3_fq3ns")
text = "As tu entendu parler de Valthorion ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Valthorion ?" unique_id=369303115 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Ah… Valthorion. 

Un nom qui résonne comme un funeste écho dans les annales de cette terre. Écoute, voyageur, et laisse tes oreilles absorber les vérités que le temps a préservées."
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Valthorion ?/Next" unique_id=530284525 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Valthorion… était un necromancien de talents, mais aussi un alchimiste dont les connaissances atteignaient les étoiles. Il croyait, avec une ferveur dévorante, qu’il pouvait briser la chaîne de la mort elle-même. Pourtant, ses expériences… ses créations… ont fini par le dévorer. On dit qu’il repose maintenant sous la montagne au sud, entouré des reliques de ses échecs… et des âmes qu’il n’a pas su dominer."
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Valthorion ?/Next/Next" unique_id=1552664280]
script = ExtResource("3_fq3ns")
text = "La montagne au sud… vous croyez qu’il repose vraiment là-bas ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Valthorion ?/Next/Next/Next" unique_id=1965494203 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "C'est ce qu'on dit. Toutefois, on n'a jamais trouvé de souterrain y menant. La montagne semble le protéger."
pnj = NodePath("../../../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Chambres de l’Équilibre ?" type="Node" parent="Alaric Duclair/Présentation/Next" unique_id=265180431]
script = ExtResource("3_fq3ns")
text = "Alaric, je cherche un emplacement appelé “Chambres de l’Équilibre”. As-tu la moindre idée d’où cela se trouve ?  "
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Alaric Duclair/Présentation/Next/Chambres de l’Équilibre ?" unique_id=1047067143 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Les Chambres de l’Équilibre… C’est un lieu mentionné dans les Chroniques des Gardiens, un texte que je possède ici, dans mes archives. [i]Alaric sort un vieux parchemin[/i].

Selon ce récit, les Chambres ont été construite sous les Ruines de Vaelith. Une ancienne cité entourée de murs de pierre noire, à l’ouest des Monts de l’Éclipse. C'est à deux jours de marche. [i]Alaric montre un emplacement sur une carte[/i].


"
pnj = NodePath("../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Pipette la Loupe" parent="." unique_id=529852479 instance=ExtResource("1_fq3ns")]
transform = Transform3D(-0.70710677, 0, -0.70710677, 0, 1, 0, 0.70710677, 0, -0.70710677, 22.4, 4, 4.5)
