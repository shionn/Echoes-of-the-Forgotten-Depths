[node name="Ferris Ardent" parent="." unique_id=1869914921 instance=ExtResource("1_fq3ns")]
transform = Transform3D(0.70710677, 0, 0.70710677, 0, 1, 0, -0.70710677, 0, 0.70710677, 0, 4, 0)
script = ExtResource("14_psk7j")

[node name="Character" parent="Ferris Ardent" unique_id=1703605445 instance=ExtResource("15_wad6c")]

[node name="DialogueJoueurFatigué" type="Node" parent="Ferris Ardent" unique_id=456705125 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Bonjour aventurier, tu sembles bien fatigué. Si tu cherches un repas chaud ou des conseils, le tenancier est là pour t'aider. Il connaît le coin mieux que personne… et il a une excellente recette de soupe."
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Dialog" type="Node" parent="Ferris Ardent" unique_id=389929622 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Bonjour. Moi, c’est Ferris Ardent. J’aime la bière, les métaux et les pierres précieuses. J’ai exploré bien des mines, mais aujourd’hui j’ai trouvé mon point de chute ici."
pnj = NodePath("..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Anneau de Valthorion" type="Node" parent="Ferris Ardent/Dialog" unique_id=651483036]
script = ExtResource("3_fq3ns")
text = "Bonjour Ferris, j’ai trouvé cette bague. Je crois qu’elle appartient à Valthorion. Dans le gouffre des ombres, j’ai trouvé Valthorion qui l’inspectait. "
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Ferris Ardent/Dialog/Anneau de Valthorion" unique_id=1013183058 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "[i]Ferris inspecte la bague[/i]. C’est bien elle… C’est mon père qui l’a fabriquée. J’étais encore enfant, mais je me souviens de ses mains sur le métal, de la manière dont il murmurait des incantations. Cette bague est liée à l’âme de Valthorion. Elle lui sert de catalyseur magique. 

[i]Ferris inspecte plus longuement la bague[/i]. Cependant… quelque chose cloche. Il n’emanne plus aucune force magique de celle-ci. Après 300 ans, elle a perdu sa force."
pnj = NodePath("../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Ferris Ardent/Dialog/Anneau de Valthorion/Next" unique_id=1625579267]
script = ExtResource("3_fq3ns")
text = "Tu dis que ton père et toi avez fabriqué cette bague ? Et qu’elle a 300 ans ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Ferris Ardent/Dialog/Anneau de Valthorion/Next/Next" unique_id=1660745055 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = "Oui, nous les nains vivons assez longtemps. Mais j’étais très petit à l’époque."
pnj = NodePath("../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Ferris Ardent/Dialog/Anneau de Valthorion/Next/Next/Next" unique_id=1619312876]
script = ExtResource("3_fq3ns")
text = "Donc cette bague a perdu sa force ? C’est une bonne nouvelle non ? Je vais probablement devoir affronter Valthorion… Elle pourrait m’aider à le battre ?"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="Ferris Ardent/Dialog/Anneau de Valthorion/Next/Next/Next/Next" unique_id=730840636 node_paths=PackedStringArray("pnj")]
script = ExtResource("3_fq3ns")
text = " Peut-être… mais il faudrait la restaurer avant. Pour cela, tu devras te rendre aux Chambres de l’Équilibre. C’est là-bas que mon père a conçu cet anneau.

Cependant, j’étais trop petit pour me souvenir de l’emplacement exact. Mais je me souviens que mon père m’a souvent rabâché qu’il avait oublié son compas là-bas. Si tu trouves où c’est, dis-le-moi. Je vais chercher ce fichu compas.  "
pnj = NodePath("../../../../../../..")
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="PanneauDAffichage" parent="." unique_id=1099766786 instance=ExtResource("11_o35sb")]
transform = Transform3D(1.2, 0, 0, 0, -5.2453668e-08, -1.2, 0, 1.2, -5.2453668e-08, 0.4, 2, -1.6999999)
script = ExtResource("12_ntc8q")
action = 1

[node name="Description" type="Node" parent="PanneauDAffichage" unique_id=59974181]
script = ExtResource("3_fq3ns")
text = "Ca ressemble à un panneau d’affichage pour des petites annonces de travail. Les primes semblent assez basse. 

Mais je suis bien trop épuisé pour repartir à l’aventure pour l’instant."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Rien" type="Node" parent="PanneauDAffichage" unique_id=308382634]
script = ExtResource("3_fq3ns")
text = "Il n'y a rien pour l'instant."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Mission 1" type="Node" parent="PanneauDAffichage" unique_id=673003918]
script = ExtResource("3_fq3ns")
text = "[i]Une note attire votre attention :[/i] 
Débarrasser les morts-vivants errant près du mausolée, non loin au nord-est de l’auberge. 
Ces créatures sont de plus en plus nombreuses… et certaines s’approchent même de l’auberge. Cela ne peut plus continuer.

Récompense : 10 Pièces d'or"
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

[node name="Next" type="Node" parent="PanneauDAffichage/Mission 1" unique_id=1451691828]
script = ExtResource("3_fq3ns")
text = "J’ai déjà fait cette mission, je devrais peut-être en parler avec le patron."
metadata/_custom_type_script = "uid://cxe0hpd6pnr8q"

