[node name="Rogue" parent="Node3D/Characters/Node3D5" unique_id=1982882119 instance=ExtResource("4_v7141")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -5)
script = ExtResource("3_khsc5")
_anim = "Melee_Dualwield_Attack_Chop"
_description = "La Voleuse
Équipée d’une dague dans chaque main, elle inflige deux attaques à chaque frappe. De plus, si elle est hors de la vision de son adversaire, elle inflige des dégâts supplémentaires. Elle possède également un sort lui permettant de disparaître pour un court instant.
[ul]
Main droite : 1 + niveau (+1 automatique dans le dos), main gauche : 2
Défense : 2 + niveau / 2
PV : 5 + niveau
Difficulté : Moyenne
Disparaître : projette un nuage de fumée pour disparaître pendant 5 secondes, se recharge en 120 secondes.
[/ul]"

